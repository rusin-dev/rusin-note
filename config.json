{
  "max_note_size_mb": 1,
  "sitename": "如形の笔记",
  "rate_limit": {
    "window_seconds": 60,
    "max_requests": 30
  },
  "get_rate_limit": {
    "window_seconds": 60,
    "max_requests": 45
  },
  "id_generation": {
    "length": 4,
    "use_uppercase": false,
    "use_lowercase": true,
    "use_digits": false
  },
  "session_timeout": {
    "enabled": false,
    "minutes": 1440
  },
  "password_policy": {
    "min_length": 8,
    "require_uppercase": true,
    "require_lowercase": true,
    "require_digits": true,
    "require_special": true
  }
}