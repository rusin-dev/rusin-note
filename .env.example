# ===== 无服务器部署（Vercel / AWS Lambda 等）必填 =====
# Vercel KV / Upstash Redis 的 REST 接口与令牌（Vercel 绑定 KV 后自动注入）
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Neon / PostgreSQL 连接串（Vercel 绑定 Neon 后自动注入为 DATABASE_URL；
# 与 KV 二选一，优先 KV）
DATABASE_URL=

# 会话/CSRF 签名密钥（必填！不设置则每次冷启动随机，用户登录态会失效）
RUSIN_SECRET_KEY=

# ===== 可选 =====
# 限流存储：设置 Redis 连接串后多实例共享限流计数（否则按实例内存计数）
REDIS_URL=

# 存储后端：file | memory | upstash | postgres（留空自动识别：
# 有 KV_REST_API_URL 用 upstash；有 DATABASE_URL 用 postgres；
# 无服务器平台用 memory；本地默认 file）
RUSIN_STORAGE=

# 本地 file 后端的数据目录（默认当前目录）
RUSIN_DATA_DIR=

# 功能开关管理员用户名（逗号分隔；也可在 config.json 的 admin_users 配置，
# 两者取并集）。设置后该用户可在 /admin/features 用滑块开关启停站点功能
RUSIN_ADMIN=