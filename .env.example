# 存储后端（本地默认 sqlite：SQLite 索引 + JSON 内容）
# 可选：sqlite / file / memory / upstash / postgres
# RUSIN_STORAGE=sqlite

# 运行数据目录（默认 data/；Zeabur 等挂载持久卷时设为 /data）
# RUSIN_DATA_DIR=data

RUSIN_SECRET_KEY=

RUSIN_ADMIN=

# 第三方登录（OAuth）、2FA 与邮箱/手机验证的凭据与开关均在 config.json 中配置：
# - oauth.providers.<github|google|microsoft|wechat|qq> 填 client_id/client_secret
# - security.smtp / security.sms 配置验证码投递（留空则仅记录日志、不发送）
# - features.oauth_* / two_factor_auth / email_verify / phone_verify 为功能开关默认值
